{
  "name": "my-poc-deployment",
  "version": "0.1.0",
  "description": "AWS CDK deployment stack for my-poc-project (Spring Boot 3.5 / Java 21)",
  "bin": {
    "deployment": "bin/deployment.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy MyPocStack-Dev --require-approval never",
    "deploy:prod": "cdk deploy MyPocStack-Prod",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.x",
    "aws-cdk": "2.1126.0",
    "jest": "^29.7.0",
    "minimatch": "3.1.2",
    "tar": "4.4.8",
    "trim": "0.0.1",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.258.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}

